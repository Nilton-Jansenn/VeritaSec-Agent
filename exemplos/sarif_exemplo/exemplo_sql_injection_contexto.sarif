{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "FerramentaSastExemplo",
          "version": "1.0.0",
          "rules": [
            {
              "id": "python.sql.injection",
              "name": "Possivel SQL Injection por concatenacao",
              "shortDescription": {
                "text": "Detecta construção de SQL por concatenação."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.sql.injection",
          "level": "warning",
          "message": {
            "text": "Possível SQL Injection: consulta SQL montada por concatenação."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/repositorio_usuario.py"
                },
                "region": {
                  "startLine": 6,
                  "endLine": 6,
                  "startColumn": 20,
                  "endColumn": 84
                }
              }
            }
          ]
        }
      ]
    }
  ]
}